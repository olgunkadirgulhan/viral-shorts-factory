# Only for LOCAL test runs. In production everything lives in GitHub Secrets / Variables
# (see README). Copy to .env.

# --- LLM ---
LLM_BACKEND=anthropic              # anthropic | ollama (ollama = local GPU only)
LLM_CREATIVE_BACKEND=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OLLAMA_MODEL=llama3.1:8b

# --- Content ---
CONTENT_LANG=en
CHANNEL_NAME=
MARKET_TICKERS=^GSPC,^IXIC,^DJI,GC=F,CL=F,DX-Y.NYB,NVDA,AAPL,MSFT,TSLA,AMZN,META
TTS_VOICE=en-US-AndrewMultilingualNeural

# --- Publishing ---
PUBLISH_TZ=America/New_York
SLOTS=07:00=SAVE,09:30=SHARE,12:30=SHARE,15:00=FOLLOW,17:30=SAVE,20:00=SHARE
YOUTUBE_PRIVACY=unlisted           # unlisted | private | scheduled (= public at slot time)

# --- Gates ---
HOOK_MIN=60
TITLE_MIN=85
OUTLIER_MIN=3.0

# --- Telegram (optional) ---
TG_TOKEN=
TG_CHAT=
